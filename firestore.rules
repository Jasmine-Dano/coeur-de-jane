rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the shop owner's login can change dresses.
    // To add another admin, add their email to this list, e.g. ['a@gmail.com', 'b@gmail.com']
    function isOwner() {
      return request.auth != null && request.auth.token.email in ['danojasmine144@gmail.com'];
    }
    match /dresses/{id} {
      allow read: if true;
      allow write: if isOwner();
    }
    match /photos/{id} {
      allow read: if true;
      allow write: if isOwner();
    }
    // Customers can send a booking request but can't read, change or delete any.
    match /bookings/{id} {
      allow read, update, delete: if isOwner();
      allow create: if request.resource.data.keys().hasOnly(['ref', 'name', 'contact', 'items', 'total', 'status', 'createdAt'])
        && request.resource.data.status == 'Pending'
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.contact is string && request.resource.data.contact.size() > 0 && request.resource.data.contact.size() <= 80
        && request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 10
        && request.resource.data.createdAt == request.time;
    }
  }
}
